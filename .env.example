# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Paddle price IDs (from Paddle dashboard → Products → MamaNote Plus)
# Sandbox IDs for development; swap for live IDs before App Store launch
EXPO_PUBLIC_PADDLE_PRICE_MONTHLY=pri_sandbox_monthly
EXPO_PUBLIC_PADDLE_PRICE_ANNUAL=pri_sandbox_annual
EXPO_PUBLIC_PADDLE_PRICE_LIFETIME=pri_sandbox_lifetime

# Optional public URL for share links (e.g. https://app.mamanote.com/share)
# Falls back to the app deep link mamanote://share/<token>
# EXPO_PUBLIC_SHARE_BASE_URL=https://your-domain.com/share

# Optional feedback & store links (Profile → Send feedback)
# Leave unset until you have these — the app works without them.
# EXPO_PUBLIC_FEEDBACK_EMAIL=hello@mamanote.com
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.mamanote.app
# EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# Paddle (server-side only — set in Supabase Edge Function secrets)
# supabase secrets set PADDLE_API_KEY=pdl_sdbx_apikey_...
# supabase secrets set PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# supabase secrets set PADDLE_ENV=sandbox
# Optional: override default payment link (must be an approved domain in Paddle)
# Leave unset to use Paddle → Checkout → Default payment link from your account
# supabase secrets set PADDLE_CHECKOUT_URL=https://yourdomain.com/checkout
